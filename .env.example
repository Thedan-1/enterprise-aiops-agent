# 数据库
DATABASE_URL=postgresql+psycopg://aiops:aiops@localhost:5433/aiops
AUTH_SECRET=  # 生产必须设置高强度随机值；留空时演示进程每次启动随机生成

# Embedder: mock_hash（默认，零依赖离线可跑） | local_st（推荐，本地开源中文模型,需要
# pip install sentence-transformers,首次运行下载模型,不需要API Key） | openai（需要Key）
EMBEDDER_PROVIDER=mock_hash
EMBEDDER_DIM=384
OPENAI_API_KEY=

# LLM: mock（默认，离线可跑，规则引擎） | anthropic | deepseek
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Agent
AGENT_MAX_ITERATIONS=5
AGENT_TIMEOUT_S=30  # 真实LLM Provider建议调到45,单轮API往返比MockLLM慢很多

# Retrieval
RETRIEVER_TOP_K_CANDIDATE=30
RETRIEVER_TOP_K_FINAL=5

# Reranker: heuristic（默认，无外部依赖） | cross_encoder（推荐，需要sentence-transformers，
# 首次运行下载 BAAI/bge-reranker-base）
RERANKER_PROVIDER=heuristic
RERANKER_MIN_SCORE=0.5
