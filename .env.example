# 数据库
DATABASE_URL=postgresql+psycopg://aiops:aiops@localhost:5433/aiops

# Embedder: mock_hash（默认，离线可跑） | openai
EMBEDDER_PROVIDER=mock_hash
EMBEDDER_DIM=384
OPENAI_API_KEY=

# LLM: mock（默认，离线可跑，规则引擎） | anthropic | openai
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Agent
AGENT_MAX_ITERATIONS=5
AGENT_TIMEOUT_S=30

# Retrieval
RETRIEVER_TOP_K_CANDIDATE=30
RETRIEVER_TOP_K_FINAL=5

# Reranker: heuristic（默认，无外部依赖） | cross_encoder
RERANKER_PROVIDER=heuristic
RERANKER_MIN_SCORE=0.5
